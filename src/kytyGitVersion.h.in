#include "cmake_config.h"

#define KYTY_GIT_VERSION "@KYTY_GIT_VERSION@"
// Short, human-facing commit name used in build labels.
#define KYTY_GIT_HASH "@KYTY_GIT_HASH@"
// Full commit identity used for compatibility checks.
#define KYTY_GIT_REVISION "@KYTY_GIT_REVISION@"
// SHA-256 of the recompiler and pipeline sources; keys the per-title shader caches.
#define KYTY_SHADER_CACHE_KEY "@KYTY_SHADER_CACHE_KEY@"

// The product name: in the window title, the log, crash reports and the Vulkan application info.
#define KYTY_PRODUCT_NAME "BryKytyPS5"

/* Build provenance, shown in the window title and in crash reports. */
#if defined(KYTY_OFFICIAL_BUILD)
#define KYTY_BUILD_LABEL KYTY_PRODUCT_NAME " official build " KYTY_RELEASE_TAG
#elif defined(KYTY_FORK_BUILD)
#define KYTY_BUILD_LABEL KYTY_PRODUCT_NAME " fork build " KYTY_BUILD_REPOSITORY " " KYTY_GIT_HASH
#else
#define KYTY_BUILD_LABEL KYTY_PRODUCT_NAME " source build " KYTY_GIT_HASH
#endif
